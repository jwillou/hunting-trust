#### Figure 1: profiles from closed-ended answers ####
# This block is separate from allresponses, which contains respondents retained
# in at least one text model. Absence of text is not a distrust response.
stopifnot(nrow(data) == 10522L,
all(c("TRUST2_cat", "TRUST4_cat", "TRUST6_cat", "Resident_binary") %in% names(data)))
profile_data = data[, c("TRUST2_cat", "TRUST4_cat", "TRUST6_cat", "Resident_binary")]
names(profile_data) = c("BM", "HO", "PP", "Resident_binary")
profile_data = profile_data[complete.cases(profile_data), ]
profile_data$BM = ifelse(profile_data$BM == "Agree", "T", "D")
profile_data$HO = ifelse(profile_data$HO == "Agree", "T", "D")
profile_data$PP = ifelse(profile_data$PP == "Agree", "T", "D")
profile_data$profile = paste0(profile_data$BM, profile_data$HO, profile_data$PP)
profile_levels = c("TTT", "TTD", "TDT", "TDD", "DTT", "DTD", "DDT", "DDD")
profile_data$profile = factor(profile_data$profile, levels = profile_levels)
profile_data$residency = ifelse(profile_data$Resident_binary == 1,
"Resident", "Non-resident")
# These are the denominators and counts for BOTH Figure 1 and Results 4.1.
profile_counts = as.data.frame(table(profile_data$profile, profile_data$residency))
names(profile_counts) = c("profile", "residency", "n")
profile_totals = aggregate(n ~ profile, profile_counts, sum)
profile_totals$percent = round(100 * profile_totals$n / nrow(profile_data), 1)
cat("Complete closed-ended T/D profiles:", nrow(profile_data), "\n")
print(profile_totals)
# These are the denominators and counts for BOTH Figure 1 and Results 4.1.
profile_counts = as.data.frame(table(profile_data$profile, profile_data$residency))
names(profile_counts) = c("profile", "residency", "n")
profile_totals = aggregate(n ~ profile, profile_counts, sum)
profile_totals$percent = round(100 * profile_totals$n / nrow(profile_data), 1)
cat("Complete closed-ended T/D profiles:", nrow(profile_data), "\n")
print(profile_totals)
print(profile_counts)
cat("Consistent profiles:\n")
print(table(profile_data$profile %in% c("TTT", "DDD")))
cat("Number of adjacent changes (BM to HO; HO to PP):\n")
print(table((profile_data$BM != profile_data$HO) +
(profile_data$HO != profile_data$PP)))
write.csv(profile_counts, "output/Figure1_profile_counts.csv", row.names = FALSE)
# The plotted flows and the accompanying count table use the same rows.
flow_data = profile_counts[profile_counts$n > 0, ]
flow_data$BM = substr(as.character(flow_data$profile), 1, 1)
flow_data$HO = substr(as.character(flow_data$profile), 2, 2)
flow_data$PP = substr(as.character(flow_data$profile), 3, 3)
stopifnot(sum(flow_data$n) == nrow(profile_data))
flow_colors = c(TTT = "forestgreen", TTD = "chartreuse3", TDT = "goldenrod2",
TDD = "darkorange2", DTT = "firebrick3", DTD = "darkred",
DDT = "orchid4", DDD = "darkorchid4")
figure1 = ggplot(flow_data,
aes(axis1 = BM, axis2 = HO, axis3 = PP, y = n)) +
geom_alluvium(aes(fill = profile), alpha = 0.85, width = 0.12) +
geom_stratum(width = 0.12, fill = "gray88", color = "black") +
scale_fill_manual(values = flow_colors, name = "Trust profile") +
scale_x_discrete(limits = c("Biological Management", "Hunting Opportunity",
"Public Participation"), expand = c(0.04, 0.04)) +
labs(x = NULL, y = "Number of respondents") + theme_classic()
print(figure1)
ggsave("output/Figure1_closed_ended_profiles.pdf", figure1, width = 9, height = 5)
# Run from the project root. Requires input/ and output/ directories.
# This analysis uses closed-ended answers; it does not require STM model objects.
library(ggplot2)
library(ggalluvial)
setwd("/Users/jannawilloughby/Google Drive/My Drive/Willoughby lab/projects - archive/hunting and trust/hunting-trust/")
input_file = "input/Binary_with_Qual_Trust_Clean_jrw22May2026.csv"
stopifnot(file.exists(input_file))
setwd("/Users/jannawilloughby/Google Drive/My Drive/Willoughby lab/projects - archive/hunting and trust/hunting-trust/")
input_file = "input/Binary_with_Qual_Trust_Clean_jrw22May2026.csv"
file.exists(input_file)
setwd("/Users/jannawilloughby/Google Drive/My Drive/Willoughby lab/projects - archive/hunting and trust/hunting-trust/")
input_file = "intput/Binary_with_Qual_Trust_Clean_jrw22May2026.csv"
stopifnot(file.exists(input_file))
survey = read.csv("intput/Binary_with_Qual_Trust_Clean_jrw22May2026.csv", stringsAsFactors = FALSE, fileEncoding = "latin1")
questions = c(BM = "TRUST2_text", HO = "TRUST4_text", PP = "TRUST6_text")
stopifnot(all(questions %in% names(survey)))
questions
# T = agree/strongly agree; N = neutral; D = disagree/strongly disagree.
# Missing and "I have never considered this" stay unclassified.
classify = function(x) {
result = rep(NA_character_, length(x))
result[x %in% c("Agree", "Strongly agree")] = "T"
result[x == "Neutral"] = "N"
result[x %in% c("Disagree", "Strongly disagree")] = "D"
result
}
classified = as.data.frame(lapply(survey[questions], classify))
names(classified) = names(questions)
answered_all = rowSums(!is.na(survey[questions]) &
survey[questions] != "") == 3L
keep = complete.cases(classified)
cat("Total survey records:", nrow(survey), "\n")
cat("Answered all three (any response option):", sum(answered_all), "\n")
cat("Retained with T/N/D on all three:", sum(keep), "\n")
cat("Excluded from those who answered all three because at least one answer was 'never considered':",
sum(answered_all & !keep), "\n")
profiles = classified[keep, , drop = FALSE]
profiles$profile = paste0(profiles$BM, profiles$HO, profiles$PP)
n_profiles = nrow(profiles)
# One row per possible response combination, including any combination with zero respondents.
axis_levels = c("T", "N", "D")
profile_levels = apply(expand.grid(axis_levels, axis_levels, axis_levels), 1,
paste0, collapse = "")
profile_counts = as.data.frame(table(factor(profiles$profile, levels = profile_levels)))
names(profile_counts) = c("profile", "n")
profile_counts$percent = round(100 * profile_counts$n / n_profiles, 1)
profile_counts = profile_counts[order(-profile_counts$n), ]
rownames(profile_counts) = NULL
print(profile_counts, row.names = FALSE)
write.csv(profile_counts, "output/Figure1_TND_profile_counts.csv", row.names = FALSE)
axis_totals = do.call(rbind, lapply(names(questions), function(axis) {
counts = table(factor(profiles[[axis]], levels = axis_levels))
data.frame(dimension = axis, response = names(counts), n = as.integer(counts),
percent = round(100 * as.integer(counts) / n_profiles, 1))
}))
rownames(axis_totals) = NULL
print(axis_totals, row.names = FALSE)
write.csv(axis_totals, "output/Figure1_TND_axis_totals.csv", row.names = FALSE)
# Each profile is a single flow. Color shows the final PP response.
flow_data = profile_counts[profile_counts$n > 0, c("profile", "n")]
flow_data$BM = factor(substr(as.character(flow_data$profile), 1, 1),
levels = axis_levels, labels = c("Trust", "Neutral", "Distrust"))
flow_data$HO = factor(substr(as.character(flow_data$profile), 2, 2),
levels = axis_levels, labels = c("Trust", "Neutral", "Distrust"))
flow_data$PP = factor(substr(as.character(flow_data$profile), 3, 3),
levels = axis_levels, labels = c("Trust", "Neutral", "Distrust"))
stopifnot(sum(flow_data$n) == n_profiles)
figure1 = ggplot(flow_data, aes(axis1 = BM, axis2 = HO, axis3 = PP, y = n)) +
geom_alluvium(aes(fill = PP), alpha = 0.75, width = 0.15, color = "white",
linewidth = 0.12) +
geom_stratum(width = 0.15, fill = "grey94", color = "grey30") +
geom_text(stat = "stratum", aes(label = after_stat(stratum)), size = 3.5) +
scale_fill_manual(values = c("Trust" = "#2f9246", "Neutral" = "#b99b38",
"Distrust" = "#884696"), name = "Public Participation") +
scale_x_discrete(limits = c("Biological Management", "Hunting Opportunity",
"Public Participation"), expand = c(0.08, 0.08)) +
labs(x = NULL, y = "Number of respondents",
subtitle = paste0("Trust, Neutral, or Distrust on all three questions (n = ",
format(n_profiles, big.mark = ","), ")")) +
theme_classic(base_size = 12) +
theme(axis.text.x = element_text(size = 10),
legend.position = "right")
print(figure1)
ggsave("output/Figure1_TND_flows.pdf", figure1, width = 11, height = 6)
# Companion table
profiles$residency = ifelse(survey$Resident_binary[keep] == 1,
"Resident", "Non-resident")
residency_levels = c("Resident", "Non-resident")
by_residency = table(factor(profiles$profile, levels = profile_levels),
factor(profiles$residency, levels = residency_levels))
profile_residency = data.frame(
